{
  "manifest_version": 3,
  "name": "BCA Absence Sync Cookie Tool",
  "version": "1.0.0",
  "description": "Automatically syncs session cookies to the BCA Absence Sync Google Apps Script.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "alarms",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "https://google.com/*",
    "https://*.google.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "BCA Absence Sync Cookie Tool",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
